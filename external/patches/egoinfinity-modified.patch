+    @staticmethod
+    def m7(side: str) -> "RobotIKConfig":
+        """RobotEra M7 humanoid — one 7-DoF arm.
+
+        Chain root = waist_pitch_link (the tree ancestor shared by both arms;
+        torso_frame is a coincident leaf and cannot be a serial-chain root).
+        The 7 joints between waist_pitch_link and <side>_hand_frame are:
+        shoulder_pitch, shoulder_roll, arm_yaw, elbow_pitch, elbow_yaw,
+        wrist_pitch, wrist_roll.
+        """
+        _limits = {
+            "left": torch.tensor([
+                [-2.79,  2.79],   # shoulder_pitch
+                [-0.56,  2.53],   # shoulder_roll
+                [-4.36,  1.22],   # arm_yaw
+                [-2.36,  0.70],   # elbow_pitch
+                [-2.79,  2.79],   # elbow_yaw
+                [-0.79,  0.79],   # wrist_pitch
+                [-1.57,  1.57],   # wrist_roll
+            ]),
+            "right": torch.tensor([
+                [-2.79,  2.79],   # shoulder_pitch
+                [-2.53,  0.56],   # shoulder_roll
+                [-1.22,  4.36],   # arm_yaw
+                [-2.36,  0.70],   # elbow_pitch
+                [-2.79,  2.79],   # elbow_yaw
+                [-0.79,  0.79],   # wrist_pitch
+                [-1.57,  1.57],   # wrist_roll
+            ]),
+        }
+        _ee = {"left": "left_hand_frame", "right": "right_hand_frame"}
+        return RobotIKConfig(
+            mjcf_path      = _ROBOTS_DIR / "m7" / "m7.xml",
+            end_link_name  = _ee[side],
+            root_link_name = "waist_pitch_link",
+            joint_limits   = _limits[side],
+        )
+
     @staticmethod
     def xlerobot(side: str) -> "RobotIKConfig":
         """XLeRobot 5-DoF SO-ARM100 arm (Rotation/Pitch/Elbow/Wrist_Pitch/Wrist_Roll)."""

+def _m7_12dof_from_keypoints(side: str) -> RobotHandConfig:
+    """RobotEra M7 5-finger hand: 12 DoF per hand.
+
+    Unlike G1, M7's left- and right-hand finger flex joints share IDENTICAL,
+    positive ranges (0..1.919 for curls), so flex scale is +1.0 on BOTH sides
+    (no per-side sign flip needed).  MANO bend angles are ≥0 (straight=0,
+    curled≈π), which matches the positive close direction.
 
+    robot_name values are short keys; sim/robots/m7/env.py re-attaches the side
+    prefix and maps them to the real MJCF joint names (hand_thumb_bend_joint,
+    hand_index_joint1, hand_mid_joint1, ...).
+    """
+    return RobotHandConfig(joints=[
+        # ── thumb: bend (opposition) + two curl joints ────────────────────────
+        JointMapping("thumb_bend",  12, "flex", scale=1.0, limit=(0.0,    1.832)),
+        JointMapping("thumb_rota1", 13, "flex", scale=1.0, limit=(-0.698, 1.745)),
+        JointMapping("thumb_rota2", 14, "flex", scale=1.0, limit=(0.0,    1.919)),
+        # ── index: abduction (spread) + MCP + PIP ─────────────────────────────
+        JointMapping("index_abd",    0, "abd",  scale=0.5, limit=(-0.174, 0.174), left_sign=-1.0),
+        JointMapping("index_mcp",    0, "flex", scale=1.0, limit=(0.0,    1.919)),
+        JointMapping("index_pip",    1, "flex", scale=1.0, limit=(0.0,    1.919)),
+        # ── middle: MCP + PIP ─────────────────────────────────────────────────
+        JointMapping("middle_mcp",   3, "flex", scale=1.0, limit=(0.0,    1.919)),
+        JointMapping("middle_pip",   4, "flex", scale=1.0, limit=(0.0,    1.919)),
+        # ── ring: MCP + PIP ───────────────────────────────────────────────────
+        JointMapping("ring_mcp",     9, "flex", scale=1.0, limit=(0.0,    1.919)),
+        JointMapping("ring_pip",    10, "flex", scale=1.0, limit=(0.0,    1.919)),
+        # ── pinky: MCP + PIP ──────────────────────────────────────────────────
+        JointMapping("pinky_mcp",    6, "flex", scale=1.0, limit=(0.0,    1.919)),
+        JointMapping("pinky_pip",    7, "flex", scale=1.0, limit=(0.0,    1.919)),
+    ])
+
+
+# ── per-robot factory ─────────────────────────────────────────────────────────
